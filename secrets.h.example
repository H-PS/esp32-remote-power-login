/*
 * secrets.h — 本地凭据（不要提交到 GitHub！）
 * ==================================================================
 * 用法：
 *   1. 把这个文件复制成 secrets.h（同目录）
 *   2. 填入你自己的真实配置
 *   3. secrets.h 已在 .gitignore 里，不会被 push
 *
 * 或者：直接在 .ino 里改配置也行（如果你不打算开源 / 不怕泄露）
 *
 * 说明：只要 secrets.h 不存在，固件会退回 .ino 里的占位值，照样能编译通过。
 */
#ifndef SECRETS_H
#define SECRETS_H

// ---- WiFi ----
#define SECRET_WIFI_SSID  "YourWiFiName"
#define SECRET_WIFI_PASS  "YourWiFiPassword"   // 开放网络填 ""

// ---- Windows 登录 ----
#define SECRET_PIN_CODE   "123456"             // 你的 Windows 登录 PIN

// ---- 局域网网页口令（防止同网段的人乱按）----
#define SECRET_PAGE_TOKEN "change_this_token"

// ---- 巴法云 MQTT ----
// 注册 https://cloud.bemfa.com/ → 控制台「MQTT设备云」建【消息型】主题
// ⚠️ 主题的「名称」和「昵称」要一致，且在新建那一刻就填对（事后改名易出现"伪在线"）
#define SECRET_BEMFA_UID   "your_32char_private_key"
#define SECRET_BEMFA_TOPIC "your_topic_name"

// ---- 目标机网卡 MAC（仅 ENABLE_WOL=1 时需要；去冒号、小写、正好 12 位）----
// ⚠️ 有线网卡与无线网卡是两个不同的 MAC，填错 = 魔法包发给了另一张卡（必然失败且无报错）
// Windows: ipconfig /all 看「以太网适配器」/「无线局域网适配器」的"物理地址"
//          例 A1-B2-C3-D4-E5-F6 → "a1b2c3d4e5f6"
#define SECRET_PC_MAC     "aabbccddeeff"   // 主目标（有线优先）
#define SECRET_PC_MAC2    ""               // 备用网卡，留空则不发
#define SECRET_PC_IP      ""               // 可选：目标机局域网 IP，填了会额外发定向单播

#endif
